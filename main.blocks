adow type="text" id=":|R4e](4{8Y%~`kUUXU="><field name="TEXT">Gracias por devolverme la corona. Siempre estaré en deuda contigo, y en reconocimiento a tu lealtad, te nombro mi caballero personal.</field></shadow></value><next><block type="device_pause" id="Zs|R-%d/1Kvr8?,t7a/y"><value name="pause"><shadow type="timePicker" id="Bg)*29oVGQ:yGBOy]xl9"><field name="ms">1000</field></shadow></value><next><block type="arcade_story_print_character_text" id="(/e)ey$bSB]_m0:8eXM{"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="+]E+Hc.=g@hd^(CLOyS!"><field name="TEXT">¡La corona ha regresado! ¡El reino celebra!</field></shadow></value><value name="label"><shadow type="text" id="]4X1s5,|0:A1o5|^[IeW"><field name="TEXT">Pueblo</field></shadow></value><next><block type="device_pause" id="@^BggtG.tn2-SR_a_KV9"><value name="pause"><shadow type="timePicker" id="3x2.xTsUvF|vuY7i:uC3"><field name="ms">1000</field></shadow></value><next><block type="sprites_destroy_all_sprites_of_kind" id="koB/NJwTHqwB9MdB?B^S"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="effect">effects.spray</field><value name="kind"><shadow type="spritekind" id="0]TD)/a2cY[ddpuqen6y"><field name="MEMBER">npc</field></shadow></value><next><block type="spritedestroy2" id="B(*dr2WJF:ldvg-ZXBwX"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="effect">effects.spray</field><value name="sprite"><block type="variables_get" id="(;TZ}3KWPTwVD/%h-x7*"><field name="VAR" id="k#dop=nJ{Ts?pBiOe^#|">nena</field></block></value><next><block type="spritedestroy2" id="Qodg=l=9HC3OG`v~n#_D"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="effect">effects.spray</field><value name="sprite"><block type="variables_get" id="05Kx|D.t8QO:@v;djLsI"><field name="VAR" id="Zf4:c0FkJ}M$Zxl}mkwa